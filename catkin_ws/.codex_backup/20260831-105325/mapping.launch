<launch>
  <arg name="maps_root" default="/home/bitcq/catkin_ws/maps" />
  <arg name="scan_topic" default="/cloud_registered" />
  <arg name="map_topic" default="/map" />
  <arg name="expected_scan_frame" default="camera_init" />
  <arg name="voxel_size" default="0.10" />
  <arg name="max_voxels" default="5000000" />
  <arg name="min_points" default="500" />
  <arg name="map_frame" default="map" />
  <arg name="odom_frame" default="odom" />
  <arg name="camera_init_frame" default="camera_init" />

  <node pkg="ground_air_mapping"
        type="map_recorder_node"
        name="ground_air_map_recorder"
        output="screen"
        required="true">
    <param name="maps_root" value="$(arg maps_root)" />
    <param name="scan_topic" value="$(arg scan_topic)" />
    <param name="map_topic" value="$(arg map_topic)" />
    <param name="expected_scan_frame" value="$(arg expected_scan_frame)" />
    <param name="voxel_size" value="$(arg voxel_size)" />
    <param name="max_voxels" value="$(arg max_voxels)" />
    <param name="min_points" value="$(arg min_points)" />
  </node>

  <!-- Mapping starts with coincident PX4 odom and FAST-LIO camera_init origins. -->
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="odom_camera_init_broadcaster"
        args="0 0 0 0 0 0 $(arg odom_frame) $(arg camera_init_frame)" />

  <node pkg="ground_air_localization"
        type="world_tf_owner_node.py"
        name="ground_air_world_tf_owner"
        output="screen"
        required="true">
    <param name="mode" value="mapping" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="rate" value="20.0" />
  </node>
</launch>
