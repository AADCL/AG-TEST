<?xml version="1.0"?>
<package format="2">
  <name>epaguav_ground_air_task_adapter</name>
  <version>0.1.0</version>
  <description>CCS task execution adapter for the ground-air robot.</description>
  <maintainer email="bitcq@example.com">bitcq</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>epgeneral_task_control</depend>
  <depend>geometry_msgs</depend>
  <depend>ground_air_msgs</depend>
  <depend>rospy</depend>
  <depend>std_srvs</depend>
  <test_depend>python3-nose</test_depend>
  <export />
</package>
