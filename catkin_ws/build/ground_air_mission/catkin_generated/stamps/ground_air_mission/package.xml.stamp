<?xml version="1.0"?>
<package format="2">
  <name>ground_air_mission</name>
  <version>0.1.0</version>
  <description>Ordered move_base mission execution for the ground-air vehicle.</description>
  <maintainer email="bitcq@example.com">bitcq</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ground_air_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>rospy</depend>
  <depend>std_srvs</depend>
</package>
