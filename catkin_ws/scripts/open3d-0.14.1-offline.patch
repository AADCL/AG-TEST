diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -32,6 +32,7 @@ option(BUILD_EXAMPLES             "Build Open3D examples programs"           ON
 option(BUILD_UNIT_TESTS           "Build Open3D unit tests"                  OFF)
 option(BUILD_BENCHMARKS           "Build the micro benchmarks"               OFF)
+option(BUILD_DOCUMENTATION        "Configure the Sphinx documentation"       OFF)
 option(BUILD_PYTHON_MODULE        "Build the python module"                  ON )
@@ -445,7 +446,9 @@ add_subdirectory(examples)
 
 # Documentation
-add_subdirectory(docs)
+if(BUILD_DOCUMENTATION)
+    add_subdirectory(docs)
+endif()
 
 # Install CMake configuration files
diff --git a/cmake/Open3DSetGlobalProperties.cmake b/cmake/Open3DSetGlobalProperties.cmake
--- a/cmake/Open3DSetGlobalProperties.cmake
+++ b/cmake/Open3DSetGlobalProperties.cmake
@@ -113,7 +113,9 @@ function(open3d_set_global_properties target)
     target_compile_definitions(${target} PRIVATE __TBB_LIB_NAME=tbb_static)
 
     # Download test data files from open3d_downloads repo.
-    add_dependencies(${target} open3d_downloads)
+    if(BUILD_UNIT_TESTS OR BUILD_EXAMPLES OR BUILD_BENCHMARKS)
+        add_dependencies(${target} open3d_downloads)
+    endif()
 
     # Strip unnecessary sections of the binary on Linux/macOS for Release builds
