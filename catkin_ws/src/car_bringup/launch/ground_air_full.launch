<launch>
  <!--
    兼容入口：一次性组合基础层、重定位层和任务层。
    新的实机流程应分别运行 base_system.launch、relocalization_system.launch、
    task_system.launch，以便在定位确认前保持任务层关闭。
  -->
  <arg name="start_mavros" default="false" />
  <arg name="fcu_url" default="/dev/serial/by-id/usb-CUAV_PX4_CUAV_Nora_0-if00:57600" />
  <arg name="gcs_url" default="" />
  <arg name="start_livox" default="true" />
  <arg name="start_localization" default="true" />
  <arg name="start_task" default="true" />
  <arg name="start_navigation" default="true" />
  <arg name="start_control" default="true" />
  <arg name="start_mission" default="true" />
  <arg name="start_ccs_task_adapter" default="false" />
  <arg name="ccs_mission_root" default="/home/bitcq/ccs_edge_ws/mission" />
  <arg name="maps_root" default="/home/bitcq/catkin_ws/maps" />

  <!-- 启动过程保持被动，不会自动解锁、起飞、降落或切换机械模态。 -->
  <include file="$(find car_bringup)/launch/base_system.launch">
    <arg name="start_mavros" value="$(arg start_mavros)" />
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="gcs_url" value="$(arg gcs_url)" />
    <arg name="start_livox" value="$(arg start_livox)" />
  </include>

  <include if="$(arg start_localization)" file="$(find car_bringup)/launch/relocalization_system.launch">
    <arg name="maps_root" value="$(arg maps_root)" />
  </include>

  <include if="$(arg start_task)" file="$(find car_bringup)/launch/task_system.launch">
    <arg name="start_navigation" value="$(arg start_navigation)" />
    <arg name="start_control" value="$(arg start_control)" />
    <arg name="start_mission" value="$(arg start_mission)" />
    <arg name="start_ccs_task_adapter" value="$(arg start_ccs_task_adapter)" />
    <arg name="ccs_mission_root" value="$(arg ccs_mission_root)" />
  </include>
</launch>
