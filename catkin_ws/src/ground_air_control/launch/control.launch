<launch>
  <!-- 兼容默认值及任务下发高度均解释为重定位后 map 坐标系的绝对 z。 -->
  <arg name="takeoff_height" default="1.0" />
  <!-- 新任务可下发绝对 map.z；以下范围是机器人侧硬安全边界。 -->
  <arg name="min_flight_altitude" default="0.5" />
  <arg name="max_flight_altitude" default="3.0" />
  <arg name="service_timeout" default="30.0" />
  <!-- 模态切换和起降均使用有界超时，任何一步失败都不会继续后续任务。 -->
  <arg name="transition_timeout" default="15.0" />
  <arg name="ground_mode_timeout" default="2.0" />
  <arg name="ground_stop_settle_time" default="0.2" />
  <arg name="takeoff_timeout" default="20.0" />
  <arg name="land_timeout" default="30.0" />
  <arg name="cmd_vel_timeout" default="0.5" />
  <arg name="control_rate" default="20.0" />
  <arg name="start_ground_actuator" default="true" />

  <node pkg="ground_air_control"
        type="mode_manager_node.py"
        name="ground_air_mode_manager"
        output="screen"
        required="true">
    <param name="takeoff_height" value="$(arg takeoff_height)" />
    <param name="min_flight_altitude" value="$(arg min_flight_altitude)" />
    <param name="max_flight_altitude" value="$(arg max_flight_altitude)" />
    <param name="service_timeout" value="$(arg service_timeout)" />
    <param name="transition_timeout" value="$(arg transition_timeout)" />
    <param name="ground_mode_timeout" value="$(arg ground_mode_timeout)" />
    <param name="ground_stop_settle_time" value="$(arg ground_stop_settle_time)" />
    <param name="takeoff_timeout" value="$(arg takeoff_timeout)" />
    <param name="land_timeout" value="$(arg land_timeout)" />
  </node>

  <node pkg="ground_air_control"
        type="cmd_vel_router_node.py"
        name="ground_air_cmd_vel_router"
        output="screen"
        required="true">
    <param name="timeout" value="$(arg cmd_vel_timeout)" />
    <param name="rate" value="$(arg control_rate)" />
  </node>

  <node if="$(arg start_ground_actuator)"
        pkg="ground_air_control"
        type="ground_actuator_node.py"
        name="ground_air_ground_actuator"
        output="screen"
        required="true">
    <param name="timeout" value="$(arg cmd_vel_timeout)" />
    <param name="rate" value="$(arg control_rate)" />
  </node>
</launch>
