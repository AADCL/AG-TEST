    <!-- body -> base_link 由 car_bringup/base_system.launch 唯一发布，避免重复 TF。 -->
    <node pkg="pcl_test" type="ground_filter_node" name="ground_filter_node" output="screen">
        <param name="input_topic" value="cloud_registered_body" />
        <param name="ground_topic" value="filtered_points_ground" />
        <param name="no_ground_topic" value="filtered_points_no_ground"/>
    </node>

    <node name="noground_trans_node" pkg="pcl_test" type="lidar_trans_node" output="screen">
        <param name="lidar_frame" value="base_link" />
        <param name="map_frame" value="map" />
    </node>
</launch>
