<launch>
	<arg name="tf_prefix" default="robot1"/>
	<!-- <arg name="namespace"  default="robot1"/> -->
    <!--  ************** Navigation ***************  -->
	<node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
	    <!-- <remap from="move_base_simple/goal" to="path_execution_node/look_ahead_goal"/> -->
  	  	<rosparam file="$(find teb_local_planner_tutorials)/cfg/diff_drive/costmap_common_params_global.yaml" command="load" ns="global_costmap" />
  	 	<rosparam file="$(find teb_local_planner_tutorials)/cfg/diff_drive/costmap_common_params_local.yaml" command="load" ns="local_costmap" />
  		<rosparam file="$(find teb_local_planner_tutorials)/cfg/diff_drive/local_costmap_params.yaml" command="load" />
  		<rosparam file="$(find teb_local_planner_tutorials)/cfg/diff_drive/global_costmap_params.yaml" command="load" />
  		<rosparam file="$(find teb_local_planner_tutorials)/cfg/diff_drive/teb_local_planner_params.yaml" command="load" />
		<!-- <rosparam file="$(find teb_local_planner_tutorials)/cfg/diff_drive/dwa_local_planner_params.yaml" command="load" /> -->
		<!-- <rosparam file="$(find mpc_local_planner_examples)/cfg/diff_drive/mpc_local_planner_params_minimum_time.yaml" command="load" /> -->

		<param name="base_global_planner" value="global_planner/GlobalPlanner" />
		<param name="planner_frequency" value="1.0" />
		<param name="planner_patience" value="5.0" />
		<rosparam file="$(find teb_local_planner_tutorials)/cfg/diff_drive/global_planner_params.yaml" command="load" />

		<param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
		<param name="controller_frequency" value="10.0" />
		<param name="controller_patience" value="15.0" />

		<!-- <param name="base_local_planner" value="dwa_local_planner/DWALocalPlannerROS" />
		<param name="controller_frequency" value="5.0" />
		<param name="controller_patience" value="15.0" /> -->

		<!-- <param name="base_local_planner" value="mpc_local_planner/MpcLocalPlannerROS" />
		<param name="controller_frequency" value="10.0" />
		<param name="controller_patience" value="15.0" /> -->

		<param name="global_costmap/global_frame" type="string" value="$(arg tf_prefix)/world" />
		<param name="global_costmap/robot_base_frame" type="string" value="$(arg tf_prefix)/base_link" />
		<param name="local_costmap/global_frame" type="string" value="$(arg tf_prefix)/world" />
		<param name="local_costmap/robot_base_frame" type="string" value="$(arg tf_prefix)/base_link" />

		<param name="static_layer/map_topic" type="string" value="/$(arg tf_prefix)/map" />
		<param name="global_costmap/obstacle_layer/laser_scan_sensor/topic" type="string" value="/$(arg tf_prefix)/rslidar_points" />
		<param name="local_costmap/obstacle_layer/laser_scan_sensor/topic" type="string" value="/$(arg tf_prefix)/rslidar_points" />
		<param name="TebLocalPlannerROS/odom_topic" type="string" value="/$(arg tf_prefix)/odom" />
		<!-- <param name="MpcLocalPlannerROS/odom_topic" type="string" value="/$(arg tf_prefix)/odom" /> -->
		
	</node>

	<!-- <node name="standalone_converter" pkg="costmap_converter" type="standalone_converter" output="screen">
		<param name="converter_plugin" value="costmap_converter::CostmapToDynamicObstacles" />
		<param name="costmap_topic" value="/$(arg tf_prefix)/move_base/local_costmap/costmap" />
		<param name="odom_topic" value="/$(arg tf_prefix)/odom" />
	</node> -->

</launch>
